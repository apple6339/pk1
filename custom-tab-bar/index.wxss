.tabbar-shell {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 999;
}

.tabbar {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 18rpx calc(env(safe-area-inset-bottom) + 10rpx);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.12);
}

.tab-item {
  flex: 1;
  text-align: center;
  color: #9ca3af;
  padding-top: 8rpx;
}

.tab-item.active {
  color: #22c55e;
}

.tab-icon {
  display: block;
  font-size: 30rpx;
  line-height: 36rpx;
  margin-bottom: 2rpx;
}

.tab-label {
  display: block;
  font-size: 18rpx;
  line-height: 28rpx;
}
