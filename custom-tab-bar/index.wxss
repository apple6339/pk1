.tabbar-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 999;
}

.tabbar {
  display: flex;
  justify-content: space-around;
  padding: 14rpx 8rpx calc(env(safe-area-inset-bottom) + 14rpx);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.12);
}

.tab-item {
  flex: 1;
  text-align: center;
  color: #9ca3af;
  padding-top: 6rpx;
}

.tab-item.active {
  color: #22c55e;
}

.tab-icon {
  display: block;
  font-size: 32rpx;
  line-height: 40rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  display: block;
  font-size: 20rpx;
  line-height: 28rpx;
}
