@import "../../styles/common.wxss";

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #ffffff;
  font-size: 28rpx;
  padding: 0 8rpx 24rpx;
}

.arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  text-align: center;
  line-height: 48rpx;
  font-size: 36rpx;
}

.weight-card,
.proof-card,
.form-card {
  padding: 28rpx;
}

.weight-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.circle-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #e7f9ee;
  color: #16a34a;
  text-align: center;
  line-height: 72rpx;
  font-size: 40rpx;
}

.circle-btn.plus {
  background: #dcfce7;
}

.weight-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #111827;
}

.unit {
  font-size: 34rpx;
  color: #6b7280;
}

.ruler {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 0 6rpx;
}

.tick {
  width: 4rpx;
  height: 18rpx;
  background: #d1d5db;
  border-radius: 999rpx;
}

.tick.active {
  height: 26rpx;
  background: #22c55e;
}

.scale-row {
  display: flex;
  justify-content: space-between;
  color: #9ca3af;
  font-size: 20rpx;
  margin-top: 16rpx;
}

.proof-image {
  height: 220rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #cbd5e1, #94a3b8);
  position: relative;
  overflow: hidden;
}

.proof-image::after {
  content: '';
  position: absolute;
  inset: 26rpx 110rpx 18rpx 110rpx;
  border-radius: 120rpx 120rpx 56rpx 56rpx;
  background: linear-gradient(180deg, #f8d0b8, #f0ab8c);
}

.proof-date {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  z-index: 2;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(15, 23, 42, 0.4);
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 88rpx;
  font-size: 26rpx;
  color: #374151;
}

.placeholder {
  flex: 1;
  color: #9ca3af;
  font-size: 24rpx;
}

.submit {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #fb923c, #f97316);
  color: #ffffff;
}
