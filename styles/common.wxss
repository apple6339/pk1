.screen {
  min-height: 100vh;
  padding: 32rpx 24rpx 176rpx;
  background: linear-gradient(180deg, #2ac769 0%, #5fd37b 180rpx, #f4f7fb 180rpx, #f4f7fb 100%);
}

.status-bar {
  height: 44rpx;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #ffffff;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.page-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(31, 41, 55, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 32rpx 0 20rpx;
}

.pill-button {
  border-radius: 999rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.row {
  display: flex;
  align-items: center;
}

.space-between {
  justify-content: space-between;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd8b8, #ff9f7a);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.avatar.blue {
  background: linear-gradient(135deg, #7cc7ff, #4b8fff);
}

.badge {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(34, 197, 94, 0.12);
  color: #16a34a;
  font-size: 22rpx;
}
